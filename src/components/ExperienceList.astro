---
import type { CollectionEntry } from 'astro:content';
import { ko } from '../i18n/ko';
import { dateTime } from '../lib/profile';

interface Props {
  heading: string;
  id: string;
  items: CollectionEntry<'experience'>['data'][];
}

const { heading, id, items } = Astro.props;
---
{items.length > 0 && (
  <section class="section-row" aria-labelledby={id} data-reveal-section>
    <h2 class="section-title" id={id}>{heading}</h2>
    <ul class="row-list experience-list">
      {items.map(({ period_start, period_end, org, role, url }) => (
        <li class="experience-row">
          <span class="organization">{url ? <a href={url}>{org}</a> : org}</span>
          <span class="period">
            <time datetime={dateTime(period_start)}>{period_start}</time>
            <span aria-hidden="true"> – </span>
            {period_end ? <time datetime={dateTime(period_end)}>{period_end}</time> : ko.current}
          </span>
          <span class="role">{role}</span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .experience-list { row-gap: 1.5rem; }

  .experience-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    gap: .2rem 1rem;
    align-items: baseline;
  }

  .organization {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.5;
  }

  .period {
    justify-self: end;
    color: var(--muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--fs-meta);
    white-space: nowrap;
  }

  .role {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: var(--fs-sub);
  }

  @media (max-width: 38rem) {
    .experience-row { grid-template-columns: minmax(0, 1fr); }
    .period { justify-self: start; }
  }
</style>
