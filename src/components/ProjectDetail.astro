---
import Bibtex from './Bibtex.astro';
import ProjectMedia from './ProjectMedia.astro';
import { ko } from '../i18n/ko';
import { resolveImage } from '../lib/images';

const linkKinds = ['paper', 'video', 'code', 'slides'] as const;

interface ProjectDetail {
  title: string;
  period: string;
  role?: string;
  team?: Array<{ name: string; affiliation?: string }>;
  links?: Partial<Record<(typeof linkKinds)[number], string>>;
  hero?: { image?: { image: string; alt: string }; video?: string; captions?: string };
  overview?: string;
  system?: Array<{ label: string; value: string }>;
  results?: Array<{ image?: string; alt?: string; caption: string }>;
  bibtex?: string;
  acknowledgment?: string;
}

interface Props {
  project: ProjectDetail;
}

const { project } = Astro.props;
const links = linkKinds.flatMap((kind) => {
  const href = project.links?.[kind];
  return href ? [{ href, label: ko.project[kind] }] : [];
});
const hero = project.hero;
const heroImage = hero?.image && resolveImage(hero.image.image);
---

<article class="project-detail" aria-labelledby="project-title">
  <header>
    <h1 id="project-title">{project.title}</h1>
    <dl class="project-facts">
      <dt>{ko.project.period}</dt>
      <dd class="period">{project.period}</dd>
      {project.role && <dt>{ko.project.role}</dt>}
      {project.role && <dd>{project.role}</dd>}
    </dl>
  </header>

  {project.team && project.team.length > 0 && (
    <section aria-labelledby="project-team">
      <h2 id="project-team">{ko.project.participants}</h2>
      <ul class="participants">
        {project.team.map(({ name, affiliation }) => (
          <li>{name}{affiliation && ` · ${affiliation}`}</li>
        ))}
      </ul>
    </section>
  )}

  {links.length > 0 && (
    <ul class="resources">
      {links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
    </ul>
  )}

  {(heroImage || hero?.video) && (
    <ProjectMedia
      image={heroImage}
      alt={hero?.image?.alt ?? project.title}
      width={1440}
      video={hero?.video}
      captions={hero?.captions}
      mode="controls"
    />
  )}

  {project.overview && (
    <section aria-labelledby="project-overview">
      <h2 id="project-overview">{ko.project.overview}</h2>
      <p class="overview">{project.overview}</p>
    </section>
  )}

  {project.system && project.system.length > 0 && (
    <section aria-labelledby="project-system">
      <h2 id="project-system">{ko.project.system}</h2>
      <table aria-labelledby="project-system">
        <tbody>
          {project.system.map(({ label, value }) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}
        </tbody>
      </table>
    </section>
  )}

  {project.results && project.results.length > 0 && (
    <section aria-labelledby="project-results">
      <h2 id="project-results">{ko.project.results}</h2>
      <div class="results">
        {project.results.map(({ image, alt, caption }) => (
          <figure>
            {image && <ProjectMedia image={resolveImage(image)} alt={alt} width={720} />}
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {project.bibtex && <Bibtex value={project.bibtex} />}

  {project.acknowledgment && (
    <section aria-labelledby="project-acknowledgment">
      <h2 id="project-acknowledgment">{ko.project.acknowledgment}</h2>
      <p>{project.acknowledgment}</p>
    </section>
  )}
</article>

<style>
  .project-detail {
    display: grid;
    gap: 1.75rem;
  }

  h1,
  h2,
  p,
  figure {
    margin: 0;
  }

  h1 {
    font-size: var(--fs-statement);
    line-height: 1.5;
  }

  h2 {
    margin-block-end: 0.5rem;
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .project-facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.25rem 1rem;
    margin-block: 0.75rem 0;
  }

  dt {
    color: var(--muted);
    font-size: var(--fs-meta);
  }

  dd {
    margin: 0;
  }

  .period {
    font-size: var(--fs-meta);
  }

  dd:not(.period),
  .participants,
  .resources,
  figcaption {
    font-size: var(--fs-sub);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .resources a {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border: 1px solid currentColor;
    text-decoration: none;
  }

  .resources a:hover {
    text-decoration: underline;
  }

  .overview {
    white-space: pre-line;
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.5rem 0.75rem;
    border-block-start: 1px solid var(--line);
    text-align: start;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  th {
    inline-size: 32%;
  }

  tr:last-child {
    border-block-end: 1px solid var(--line);
  }

  .results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  figcaption {
    margin-block-start: 0.5rem;
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .results {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
