---
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import { ko } from '../i18n/ko';
import { resolveImage } from '../lib/images';
import { dateTime } from '../lib/profile';
import { projectPath } from '../lib/projects';

interface Props {
  items: CollectionEntry<'projects'>['data'][];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="section-row" aria-labelledby="projects" data-reveal-section>
    <h2 class="section-title" id="projects">{ko.sections.projects}</h2>
    <ul class="row-list">
      {items.map(({ title, slug, period, summary, thumbnail, video, has_detail }) => (
        <li class:list={['project-row', { 'with-photo': thumbnail }]}>
          {thumbnail && (
            <div class="project-photo">
              <ProjectMedia
                image={resolveImage(thumbnail.image)}
                alt={thumbnail.alt}
                width={640}
                height={400}
                video={video}
                mode="hover"
              />
            </div>
          )}
          <div class="project-copy">
            <h3>{has_detail ? <a href={projectPath(slug)}>{title}</a> : title}</h3>
            {thumbnail && <p>{summary}</p>}
            <time datetime={dateTime(period)}>{period}</time>
            {!thumbnail && <p>{summary}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .with-photo {
    display: grid;
    grid-template-columns: 60% minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .project-photo {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
  }

  .project-photo :global(.media),
  .project-photo :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .project-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    grid-template-areas:
      "title period"
      "description .";
    gap: .2rem 1rem;
    align-items: baseline;
  }

  .with-photo .project-copy {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "title"
      "description"
      "period";
  }

  h3 {
    grid-area: title;
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 700;
    line-height: 1.5;
  }

  p {
    grid-area: description;
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-sub);
  }

  time {
    grid-area: period;
    color: var(--muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--fs-meta);
  }

  @media (max-width: 38rem) {
    .with-photo { grid-template-columns: minmax(0, 1fr); }

    .project-row:not(.with-photo) .project-copy {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "title"
        "period"
        "description";
    }
  }
</style>
