---
import type { socialLinks } from '../lib/profile';

interface Props {
  items: ReturnType<typeof socialLinks>;
}

const { items } = Astro.props;
---
{items.length > 0 && (
  <ul class="social-links" role="list">
    {items.map(({ key, label, url }, index) => (
      <li>
        {index > 0 && <span aria-hidden="true"> / </span>}
        <a lang={key === 'email' ? undefined : 'en'} href={url}>{label}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: .1rem .38rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li { white-space: nowrap; }
  span { margin-inline-end: .25rem; color: var(--muted); }
</style>
