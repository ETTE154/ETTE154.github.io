---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ExperienceList from '../components/ExperienceList.astro';
import NewsList from '../components/NewsList.astro';
import ProjectList from '../components/ProjectList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { ko } from '../i18n/ko';
import { resolveImage } from '../lib/images';
import { dateTime, formatBuildDate, fullName, getProfile, socialLinks } from '../lib/profile';
import { getPublicProjects } from '../lib/projects';

const [profile, newsFeed, projects, experienceEntries] = await Promise.all([
  getProfile(),
  getEntry('news', 'feed'),
  getPublicProjects(),
  getCollection('experience'),
]);
const name = fullName(profile);
const photo = resolveImage(profile.photo.image);
const links = socialLinks(profile);
const footerLinks = links.filter(({ key }) => key === 'github' || key === 'youtube');
const introParts = profile.intro?.split(/(RECS Lab|\s+)/u);
const updated = formatBuildDate(new Date());
const news = (newsFeed?.data.items ?? []).toSorted((a, b) => b.date.localeCompare(a.date));
const experience = experienceEntries.map(({ data }) => data).sort((a, b) => b.period_start.localeCompare(a.period_start));
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name_ko,
  alternateName: profile.name_en,
  url: Astro.site!.href,
  affiliation: { '@type': 'CollegeOrUniversity', name: profile.university },
  worksFor: { '@type': 'Organization', name: profile.company },
  sameAs: links.filter(({ key }) => key !== 'email').map(({ url }) => url),
};
const structuredData = JSON.stringify(person).replaceAll('<', '\\u003c');
---
<Base profile={profile}>
  <script slot="head" type="application/ld+json" set:html={structuredData} />
  <main class="site-width">
    <header class="hero">
      <div class="hero-copy">
        <h1>{profile.name_ko} <span lang="en">{profile.name_en}</span></h1>
        <p class="statement">{profile.statement}</p>
        <p class="affiliation">{profile.position} · <span class="company-word">{profile.company} {profile.company_role}</span></p>
      </div>
      {links.length > 0 && (
        <div class="hero-links"><SocialLinks items={links} /></div>
      )}
    </header>

    <div class="sections">
      {introParts && (
        <section class="section-row" aria-labelledby="about" data-reveal-section>
          <h2 class="section-title" id="about">{ko.sections.about}</h2>
          <div class="about-content">
            <Image
              class="portrait"
              src={photo}
              alt={profile.photo.alt}
              width={140}
              height={140}
              densities={['2x']}
              fit="cover"
              format="webp"
              loading="lazy"
            />
            <p class="about-text">{introParts.map((part) => (
              part === 'RECS Lab' ? <a href={profile.lab.url}>{part}</a> :
              part.startsWith(profile.company) ? <span class="company-word">{part}</span> : part
            ))}</p>
          </div>
        </section>
      )}
      <NewsList items={news} />
      <ExperienceList heading={ko.sections.experience} id="experience" items={experience.filter(({ type }) => type === 'position')} />
      <ExperienceList heading={ko.sections.education} id="education" items={experience.filter(({ type }) => type === 'education')} />
      <ProjectList items={projects} />
    </div>
  </main>
  <footer class="site-width footer">
    <SocialLinks items={footerLinks} />
    <p>© {name} · {ko.updated} <time datetime={dateTime(updated)}>{updated}</time></p>
  </footer>
</Base>

<script>
  const sectionSelector = '[data-reveal-section]';
  const sections = document.querySelectorAll(sectionSelector);
  const threshold = 0.15;

  if (sections.length && 'IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        // Keep a section readable if it is too tall for 15% of it to fit on screen.
        const tooTall = entry.rootBounds && entry.boundingClientRect.height * threshold > entry.rootBounds.height;

        if (entry.intersectionRatio >= threshold || tooTall) {
          reveal(entry.target);
        }
      }
    }, { threshold });

    function reveal(section: Element) {
      section.setAttribute('data-revealed', '');
      observer.unobserve(section);
    }

    for (const section of sections) {
      observer.observe(section);
    }

    document.addEventListener('focusin', (event) => {
      const section = event.target instanceof Element && event.target.closest(sectionSelector);
      if (section && !section.hasAttribute('data-revealed')) reveal(section);
    });

    document.documentElement.classList.add('js');
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-block-size: 100svh;
    padding-block: 2rem 6rem;
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
  }

  .hero h1 {
    display: flex;
    align-items: baseline;
    gap: .65rem;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .hero h1 span {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 400;
  }

  .statement {
    max-inline-size: 45rem;
    margin: 0;
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .affiliation {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .hero-links {
    margin-block-start: 1rem;
    font-size: .875rem;
  }

  .company-word { white-space: nowrap; }

  .sections {
    display: grid;
    gap: var(--section-gap);
    margin-block-start: var(--section-gap);
  }

  .sections:empty { display: none; }

  .about-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8.75rem;
    gap: 1.5rem;
    align-items: start;
  }

  .portrait {
    grid-area: 1 / 2;
    inline-size: 8.75rem;
    block-size: 8.75rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: .25rem;
  }

  .about-text {
    grid-area: 1 / 1;
    margin: 0;
    font-size: 1rem;
    line-height: 1.85;
  }

  .footer {
    display: grid;
    gap: .5rem;
    margin-block-start: var(--section-gap);
    padding-block-end: 3rem;
    color: var(--muted);
    font-size: .8125rem;
  }

  .footer p { margin: 0; }

  @media (max-width: 38rem) {
    .hero {
      min-block-size: max(80svh, calc(100svh - var(--section-gap)));
      padding-block-end: 5rem;
    }

    .statement { font-size: 1.5rem; }

    .about-content {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .portrait {
      grid-area: 1 / 1;
      inline-size: 6rem;
      block-size: 6rem;
    }

    .about-text { grid-area: 2 / 1; }
  }
</style>
